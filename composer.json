{
  "name": "bytic/medialibrary",
  "description": "Media Library used by Nip Framework",
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "autoload": {
    "psr-4": {
      "ByTIC\\MediaLibrary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ByTIC\\MediaLibrary\\Tests\\": "tests/src",
      "ByTIC\\MediaLibrary\\Tests\\Fixtures\\": "tests/fixtures"
    }
  },
  "require": {
    "bytic/filesystem": "^2.0",
    "bytic/orm": "^2.0",
    "ext-json": "*",
    "intervention/image": "^4.4",
    "php": "^8.3",
    "symfony/http-foundation": "^6.0 || ^7.0 || ^8.0"
  },
  "suggest": {
    "ext-gd": "Required for image manipulation with the GD driver.",
    "ext-imagick": "Required for image manipulation with the Imagick driver."
  },
  "require-dev": {
    "bytic/container": "^2.0",
    "bytic/logger": "^2.0",
    "bytic/migrations": "^0.13",
    "bytic/phpqatools": "^1.0",
    "bytic/router": "^2.0",
    "mockery/mockery": "^1.6"
  },
  "scripts": {
    "tests": [
      "@analyse",
      "@test"
    ],
    "test": [
      "phpunit"
    ],
    "analyse": [
      "@stan",
      "@psalm"
    ],
    "stan": "phpstan analyse",
    "psalm": "psalm --output-format=compact --find-dead-code --find-unused-psalm-suppress --long-progress "
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
